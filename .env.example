# ────────────────────────────────────────────────────────────────────────
#  Acervo do Marvete — environment template
#  Copy to `.env` and fill in. NEVER commit `.env`.
#  SECRET values are server/build-time only — they must never reach the
#  browser bundle (no VITE_ prefix on secrets).
# ────────────────────────────────────────────────────────────────────────

# --- Airtable (inventory single source of truth) ----------------------
AIRTABLE_TOKEN=            # personal access token (read scope on the base)
AIRTABLE_BASE_ID=          # e.g. appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Catalog     # table name (default: Catalog)

# --- Cloudinary (image CDN) -------------------------------------------
# The cloud name is public and safe to expose. The upload preset MUST be
# a restricted/signed preset — never an open unsigned preset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=          # API key for signed upload endpoint (/api/admin/sign-upload)
CLOUDINARY_API_SECRET=       # SECRET: Cloudinary API secret (server-time only)
CLOUDINARY_FOLDER=sale-catalog  # optional; defaults to sale-catalog

# --- Deploy Hook & Environment ----------------------------------------
DEPLOY_HOOK_URL=             # SECRET: Cloudflare Pages Deploy Hook URL triggered after admin actions
VITE_SITE_URL=https://acervodomarvete.com.br  # public site origin (used for canonical/OG)
ENVIRONMENT=                 # production | preview | development

# --- Mercado Pago (checkout) ------------------------------------------
# Server/build-time only. Used by the 6B webhook function.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
