# src/data/products.sample.json.
src/data/products.generated.json

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Hive agent runtime state (ephemeral); plan/context under features/ are kept
.hive/sessions.json
.hive/active-feature
.hive/features/*/sessions.json
